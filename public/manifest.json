{
  "manifest_version": 3,
  "name": "pjampjam's Sorare NBA Essentials",
  "short_name": "Sorare NBA",
  "version": "2.7.5",
  "version_name": "2.7.5-exp7",
  "description": "Sorare NBA Collect Helper, Craft Reveal & Probability EV Advisor, and Essence Optimizer by pjampjam.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open pjampjam's Sorare NBA Essentials",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://sorare.com/*", "https://*.sorare.com/*"],
      "js": ["content/sorareDetector.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.png"],
      "matches": ["https://sorare.com/*", "https://*.sorare.com/*"]
    }
  ],
  "permissions": ["sidePanel", "storage", "alarms", "notifications", "scripting"],
  "host_permissions": [
    "https://api.sorare.com/*",
    "https://sorare.com/*",
    "https://site.api.espn.com/*"
  ]
}
